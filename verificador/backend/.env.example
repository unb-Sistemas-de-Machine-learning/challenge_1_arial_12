# Aplicacao
APP_DEBUG=true
# Lista JSON de origens permitidas; ["*"] preserva o comportamento do stub.
CORS_ORIGINS='["*"]'
# Limite de requisicoes por origem (cabecalho Origin) dentro da janela abaixo.
# Passado o limite, a rota responde 429 ate a janela reiniciar. Nao vale para
# GET /health.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# LLM (so camada gratuita): groq ou gemini
# Chave gratuita: https://console.groq.com/keys ou https://aistudio.google.com/apikey
LLM_PROVEDOR=groq
LLM_API_KEY=
# Vazio usa o padrao do provedor (groq: openai/gpt-oss-20b; gemini: gemini-3.5-flash)
LLM_MODELO=
# Tempo total de cada chamada, tentativas incluidas, e numero de tentativas em
# falha transitoria (429, 5xx, falha de conexao).
LLM_TIMEOUT_SEGUNDOS=15
LLM_MAX_TENTATIVAS=2
# json_schema (padrao) ou json_object, para modelos sem saida estruturada
LLM_FORMATO_JSON=json_schema

# Banco (dentro do docker compose, o host e "db")
DATABASE_URL=postgresql+asyncpg://verificador:verificador@db:5432/verificador

# OpenAlex (o polite pool pede um e-mail de contato)
OPENALEX_MAILTO=
# Chave gratuita (https://openalex.org/rest-api). Sem ela, a OpenAlex trata o
# trafego como anonimo e responde 503 quando o cluster esta sob carga --
# mesmo com o OPENALEX_MAILTO preenchido. Vai no cabecalho, nunca na URL.
OPENALEX_API_KEY=
# Resultados por busca. Acima de 50 o cliente reduz para 50.
OPENALEX_RESULTADOS_POR_BUSCA=10
# Tempo maximo de cada requisicao e numero de tentativas em falha transitoria
# (429, 5xx, timeout). A espera entre elas cresce: 0,5s e depois 1s.
OPENALEX_TIMEOUT_SEGUNDOS=10
OPENALEX_MAX_TENTATIVAS=3
